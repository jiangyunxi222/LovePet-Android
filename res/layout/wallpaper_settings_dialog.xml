<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/wallpaper_dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pet_icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/wallpaper_settings"
                android:textColor="@color/wallpaper_dialog_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wallpaper_dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/wallpaper_dialog_ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/wallpaper_dialog_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@null"
            android:minHeight="44dp"
            android:text="@string/wallpaper_open_picker"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/wallpaper_dialog_app_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@null"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:text="@string/wallpaper_open_app_info"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Button
                android:id="@+id/wallpaper_dialog_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@null"
                android:minHeight="44dp"
                android:minWidth="0dp"
                android:text="@string/wallpaper_settings_cancel"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
