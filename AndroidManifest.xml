<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.bandorilove.lovepet">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
        <intent>
            <action android:name="androidx.activity.result.contract.action.PICK_IMAGES" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <permission android:name="io.bandorilove.lovepet.permission.DESKTOP_RUNTIME" android:protectionLevel="signature" />
    <uses-permission android:name="io.bandorilove.lovepet.permission.DESKTOP_RUNTIME" />
    <application android:label="BandoriLovePet" android:icon="@drawable/pet_icon"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/PetActivityTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WallpaperSettingsActivity" android:exported="true"
            android:theme="@style/WallpaperSettingsTheme"
            android:label="@string/wallpaper_settings" android:icon="@drawable/wallpaper_settings_icon" />
        <service android:name=".PetService" android:exported="false" android:process=":desktop" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled interactive Live2D desktop pet overlay" />
        </service>
        <service android:name=".PetWallpaperService" android:label="@string/wallpaper_label"
            android:icon="@drawable/pet_wallpaper_thumbnail" android:process=":desktop"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/pet_wallpaper" />
        </service>
    </application>
</manifest>
